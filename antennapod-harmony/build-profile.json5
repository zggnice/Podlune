          "keyAlias": "debugKey",
          "keyPassword": "000000192F6AA7F4FB50DB13F04CC0B2BC020BEA7123E94786D28A39E2FB046D66114515D321B09D02",
          "profile": "C:\\Users\\房东家的鳄鱼\\.ohos\\config\\default_antennapod-harmony_oHBs4b8M-JS2l1meWj0lmueaBZ1FvPgDtJCOqZeqXyU=.p7b",
          "signAlg": "SHA256withECDSA",
